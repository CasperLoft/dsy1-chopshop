@startuml
left to right direction
actor Operator
actor "External recall user" as User
rectangle "ChopShop" {
  component "Registration\nREST + PostgreSQL + outbox" as R
  component "Processing\nREST + PostgreSQL + outbox" as C
  component "Packaging\nREST + PostgreSQL + outbox" as P
  queue "RabbitMQ\ndurable exchange and queue" as Q
  component "Traceability\ngRPC + PostgreSQL projection" as T
}
Operator --> R : register animal
Operator --> C : register part in tray
Operator --> P : register product
R --> Q : animal.registered
C --> Q : part.registered
P --> Q : product.created
Q --> T : consume and acknowledge
User --> T : recall queries
@enduml
